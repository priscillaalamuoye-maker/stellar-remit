# Soroban / Stellar network
NEXT_PUBLIC_SOROBAN_RPC_URL=https://soroban-testnet.stellar.org
NEXT_PUBLIC_NETWORK_PASSPHRASE="Test SDF Network ; September 2015"
NEXT_PUBLIC_CONTRACT_ID=

# Settlement token (USDC Stellar Asset Contract address on target network)
NEXT_PUBLIC_SETTLEMENT_TOKEN=

# CI/CD deploy secret — NEVER commit the real value.
# Set this as a GitHub Actions repository/environment secret named
# SOROBAN_DEPLOYER_SECRET instead.
SOROBAN_DEPLOYER_SECRET=
